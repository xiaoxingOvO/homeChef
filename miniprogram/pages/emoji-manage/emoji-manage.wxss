/* pages/emoji-manage/emoji-manage.wxss */

.page {
  padding: 16rpx 32rpx;
  padding-bottom: 80rpx;
}

.back-bar {
  font-size: 40rpx;
  font-weight: 600;
  padding: 12rpx 0 20rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--text2);
  font-weight: 400;
}

.hint-text {
  font-size: 24rpx;
  color: var(--text2);
  margin-bottom: 20rpx;
  display: block;
}

.text-muted {
  color: #c6c6c8;
  font-size: 26rpx;
}

.btn-add {
  display: inline-block;
  background: var(--pri);
  color: #fff;
  border: none;
  border-radius: 80rpx;
  padding: 16rpx 44rpx;
  font-weight: 600;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.btn-add.small {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.emoji-item {
  font-size: 56rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e5e5ea;
  position: relative;
}

.my-emoji {
  cursor: pointer;
}

.recommended {
  cursor: pointer;
}

.remove-tag {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  font-size: 20rpx;
  background: var(--danger);
  color: #fff;
  border-radius: 20rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗 */
.modal-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.4); display:none; justify-content:center; align-items:center; z-index:1000; }
.modal-mask.show { display:flex; }
.modal-box { background:#fff; border-radius:56rpx; padding:56rpx 48rpx 48rpx; width:90%; max-width:680rpx; }
.modal-title { font-size:40rpx; font-weight:600; margin-bottom:16rpx; }
.modal-sub { color:var(--text2); font-size:28rpx; margin-bottom:24rpx; display:block; }
.modal-actions { display:flex; gap:24rpx; margin-top:16rpx; }
.btn-cancel { flex:1; padding:24rpx; border-radius:80rpx; border:none; font-weight:600; font-size:30rpx; background:#f0f0f3; color:#3a3a3c; }
.btn-confirm { flex:1; padding:24rpx; border-radius:80rpx; border:none; font-weight:600; font-size:30rpx; background:var(--pri); color:#fff; }
.form-input { width:100%; padding:24rpx 28rpx; border-radius:32rpx; border:1px solid #e5e5ea; font-size:30rpx; background:#f9f9fb; }

.emoji-input {
  font-size: 64rpx;
  text-align: center;
  height: 120rpx;
}
