<!--pages/emoji-manage/emoji-manage.wxml - 图标管理-->
<view class="page">
  <view class="back-bar" bindtap="goBack">← 图标管理</view>

  <!-- 我的图标 -->
  <view class="card">
    <view class="card-title">⭐ 我的图标 <text class="card-sub">{{customEmojis.length}} 个</text></view>
    <text class="hint-text">💡 编辑菜品时显示的快捷图标。点击图标可移除（最少保留4个）</text>
    <view class="emoji-grid">
      <view
        class="emoji-item my-emoji"
        wx:for="{{customEmojis}}"
        wx:key="*this"
        bindtap="removeEmoji"
        data-emoji="{{item}}"
      >
        <text>{{item}}</text>
        <text class="remove-tag">✕</text>
      </view>
    </view>
    <view wx:if="{{customEmojis.length === 0}}" class="text-muted">还没有图标，从下方推荐库添加</view>
    <button class="btn-add small" bindtap="openAddEmoji">➕ 自定义添加</button>
  </view>

  <!-- 推荐图标库 -->
  <view class="card">
    <view class="card-title">📚 推荐图标库 <text class="card-sub">170 个</text></view>
    <text class="hint-text">💡 点击图标即可添加到「我的图标」</text>
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input placeholder="搜索推荐图标..." value="{{searchText}}" bindinput="onSearch" />
    </view>
    <scroll-view scroll-y style="max-height:500rpx;">
      <view class="emoji-grid">
        <text
          class="emoji-item recommended"
          wx:for="{{filteredRecommended}}"
          wx:key="*this"
          bindtap="addEmoji"
          data-emoji="{{item}}"
        >{{item}}</text>
      </view>
      <view wx:if="{{filteredRecommended.length === 0}}" class="text-muted" style="padding:16rpx;">
        {{searchText ? '没有匹配的图标' : '所有推荐图标都已添加'}}
      </view>
    </scroll-view>
  </view>
</view>

<!-- 自定义添加弹窗 -->
<view class="modal-mask {{showAddModal ? 'show' : ''}}" bindtap="closeAddModal">
  <view class="modal-box" catchtap="noop">
    <view class="modal-title">😊 自定义添加图标</view>
    <text class="modal-sub">输入一个推荐库中没有的 emoji 图标</text>
    <input class="form-input emoji-input" placeholder="输入 emoji，如 🧁" value="{{newEmoji}}" bindinput="onEmojiInput" maxlength="4" />
    <text class="modal-sub text-muted">💡 如果推荐库里有，直接点就行；这里用于添加库外的图标</text>
    <view class="modal-actions">
      <button class="btn-cancel" bindtap="closeAddModal">取消</button>
      <button class="btn-confirm" bindtap="confirmAddEmoji">添加</button>
    </view>
  </view>
</view>

<!-- Toast -->
<view class="toast {{toastShow ? 'show' : ''}}">{{toastMsg}}</view>
