<!--pages/category-manage/category-manage.wxml - 分类管理-->
<view class="page">
  <view class="title-bar">
    <view class="back-bar" bindtap="goBack">← 分类管理</view>
    <view class="btn-add" bindtap="openAdd">＋ 新增</view>
  </view>

  <view class="card category-list">
    <view
      class="category-item {{dragActive && draggingIndex === index ? 'dragging' : ''}}"
      style="{{dragActive && draggingIndex === index ? 'transform: translateY(' + dragTranslateY + 'px);' : ''}}"
      wx:for="{{categories}}"
      wx:key="_id"
    >
      <view class="cat-name">
        <text>{{item.name}}</text>
        <text class="badge system" wx:if="{{item.isSystem}}">系统</text>
      </view>
      <view class="cat-actions">
        <view
          class="edit-btn {{item.isSystem ? 'disabled' : ''}}"
          bindtap="openEdit"
          data-id="{{item._id}}"
          data-name="{{item.name}}"
          data-system="{{item.isSystem}}"
          aria-label="修改{{item.name}}名称"
        >✎</view>
        <view
          class="del-btn {{item.isSystem ? 'disabled' : ''}}"
          bindtap="deleteCat"
          data-id="{{item._id}}"
          data-name="{{item.name}}"
          data-system="{{item.isSystem}}"
          aria-label="删除{{item.name}}"
        >✕</view>
        <view
          class="drag-handle"
          bindlongpress="onDragStart"
          catchtouchmove="onDragMove"
          catchtouchend="onDragEnd"
          catchtouchcancel="onDragEnd"
          data-index="{{index}}"
          aria-label="长按拖动{{item.name}}"
        >☰</view>
      </view>
    </view>
  </view>

  <text class="hint">💡 删除分类后，该分类下的菜品会自动归入「其他」</text>
</view>

<!-- 新增弹窗 -->
<view class="modal-mask {{showAddModal ? 'show' : ''}}" bindtap="closeAdd">
  <view class="modal-box" catchtap="noop">
    <view class="modal-title">📂 新增分类</view>
    <input class="form-input" placeholder="分类名称" value="{{newCatName}}" bindinput="onNameInput" />
    <view class="modal-actions">
      <button class="btn-cancel" bindtap="closeAdd">取消</button>
      <button class="btn-confirm" bindtap="confirmAdd" disabled="{{adding}}">{{adding ? '添加中…' : '添加'}}</button>
    </view>
  </view>
</view>

<!-- 修改分类弹窗 -->
<view class="modal-mask {{showEditModal ? 'show' : ''}}" bindtap="closeEdit">
  <view class="modal-box edit-modal-box" catchtap="noop">
    <view class="modal-title">修改分类名称</view>
    <input
      class="form-input"
      placeholder="分类名称"
      value="{{editingCatName}}"
      focus="{{showEditModal}}"
      bindinput="onEditNameInput"
    />
    <view class="modal-actions">
      <button class="btn-cancel" bindtap="closeEdit">取消</button>
      <button class="btn-confirm" bindtap="confirmEdit">保存</button>
    </view>
  </view>
</view>

<!-- Toast -->
<view class="toast {{toastShow ? 'show' : ''}}">{{toastMsg}}</view>
