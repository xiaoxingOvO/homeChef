<!--pages/dish-manage/dish-manage.wxml - 菜品管理-->
<view class="page">
  <view class="title-bar">
    <view class="back-bar" bindtap="goBack">← 菜品管理</view>
    <view class="btn-add" bindtap="openAddDish">＋ 新增</view>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input placeholder="搜索菜品..." value="{{searchText}}" bindinput="onSearch" />
  </view>

  <scroll-view
    class="category-tabs"
    scroll-x="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="category-tabs-inner">
      <text
        class="category-tab {{currentCategory === item ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        bindtap="selectCategory"
        data-cat="{{item}}"
      >{{item}}</text>
    </view>
  </scroll-view>

  <!-- 批量操作栏 -->
  <view class="batch-bar" wx:if="{{selectedCount > 0}}">
    <text class="batch-count">已选 {{selectedCount}} 道</text>
    <button class="btn-sm btn-outline" bindtap="openBatchCategory">📂 改分类</button>
    <button class="btn-sm btn-danger-outline" bindtap="batchDelete">🗑️ 删除</button>
  </view>

  <!-- 菜品列表 -->
  <view wx:if="{{dishes.length > 0}}">
    <view class="manage-item" wx:for="{{dishes}}" wx:key="_id">
      <view class="dm-checkbox {{item.selected ? 'checked' : ''}}" bindtap="toggleSelect" data-id="{{item._id}}">
        <text wx:if="{{item.selected}}">✓</text>
      </view>
      <view class="dm-thumb">
        <image
          wx:if="{{item.displayImage}}"
          src="{{item.displayImage}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          binderror="onDishImageError"
          data-id="{{item._id}}"
        />
        <text wx:else>{{item.emoji}}</text>
      </view>
      <text class="dm-name">{{item.name}}</text>
      <text class="dm-category">{{item.category}}</text>
      <text class="dm-stars">{{item.starsText}}</text>
      <view class="dm-actions">
        <text class="edit-dm" bindtap="editDish" data-id="{{item._id}}">✏️</text>
        <text class="del-dm" bindtap="deleteOne" data-id="{{item._id}}" data-name="{{item.name}}">🗑️</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="big-icon">📖</view>
    <text>没有匹配的菜品</text>
  </view>
</view>

<!-- 改分类弹窗 -->
<view class="modal-mask {{showCategoryModal ? 'show' : ''}}" bindtap="closeCategoryModal">
  <view class="modal-box" catchtap="noop">
    <view class="modal-title">📂 选择分类</view>
    <view
      class="picker-item"
      wx:for="{{categories}}"
      wx:key="*this"
      wx:if="{{item !== '全部'}}"
      bindtap="confirmBatchCategory"
      data-cat="{{item}}"
    >
      <text>📂 {{item}}</text>
      <text class="picker-add">选择 ›</text>
    </view>
    <view class="modal-actions">
      <button class="btn-cancel" bindtap="closeCategoryModal">取消</button>
    </view>
  </view>
</view>

<!-- Toast -->
<view class="toast {{toastShow ? 'show' : ''}}">{{toastMsg}}</view>
