/* pages/profile/profile.wxss */

page {
  min-height: 100vh;
  background: #f2f2f7;
}

.page {
  padding: 16rpx 32rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f2f2f7;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 20rpx;
}

.panel-back {
  font-size: 40rpx;
  font-weight: 600;
}

.hint {
  font-size: 26rpx;
  color: var(--text2);
  padding: 16rpx 8rpx;
  display: block;
}

.text-muted {
  color: #c6c6c8;
  font-size: 26rpx;
}

.btn-danger-outline {
  background: transparent;
  color: var(--danger);
  border: 1px solid #ff3b3040;
}

.batch-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #f9f9fb;
  border-radius: 32rpx;
  border: 1px solid #f0f0f3;
  margin-bottom: 24rpx;
}

.batch-count {
  font-size: 26rpx;
  color: var(--text2);
  margin-right: 8rpx;
}

.manage-item {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1px solid #f5f5f8;
  gap: 20rpx;
}

.manage-item:last-child {
  border-bottom: none;
}

.dm-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 3rpx solid #c6c6c8;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
}

.dm-checkbox.checked {
  background: var(--pri);
  border-color: var(--pri);
}

.dm-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f0f0f3;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.dm-thumb image {
  width: 100%;
  height: 100%;
}

.dm-name {
  flex: 1;
  font-weight: 500;
  font-size: 30rpx;
  color: var(--text);
}

.dm-category {
  font-size: 24rpx;
  color: var(--text2);
  background: #f0f0f3;
  padding: 4rpx 20rpx;
  border-radius: 60rpx;
}

.dm-stars {
  font-size: 22rpx;
}

.dm-actions {
  display: flex;
  gap: 8rpx;
}

.edit-dm {
  color: var(--pri);
  background: var(--pri-light);
  padding: 4rpx 16rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.del-dm {
  color: var(--danger);
  background: #ff3b3010;
  padding: 4rpx 16rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.list-footer {
  padding: 24rpx 0 40rpx;
  text-align: center;
  color: var(--text2);
  font-size: 24rpx;
}

.category-item {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1px solid #f5f5f8;
  transition: background 0.15s ease, box-shadow 0.15s ease;
}

.category-item:last-child {
  border-bottom: none;
}

.category-item.dragging {
  z-index: 10;
  background: var(--pri-light);
  box-shadow: 0 8rpx 24rpx rgba(60, 30, 10, 0.1);
  transition: none;
  will-change: transform;
}

.cat-name {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  font-weight: 500;
  font-size: 30rpx;
  color: var(--text);
}

.badge.system {
  background: #f0f0f3;
  color: var(--text2);
  font-size: 20rpx;
  padding: 2rpx 20rpx;
  border-radius: 40rpx;
  margin-left: 16rpx;
}

.cat-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.edit-btn,
.del-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1;
  box-sizing: border-box;
}

.edit-btn {
  color: var(--pri);
  background: var(--pri-light);
}

.drag-handle {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text2);
  background: #f5f2ef;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1;
  user-select: none;
  touch-action: none;
}

.del-btn {
  color: var(--danger);
  background: #ff3b3010;
}

.del-btn.disabled {
  color: #c6c6c8;
  background: #f0f0f3;
}

.edit-btn.disabled {
  color: #c6c6c8;
  background: #f0f0f3;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.emoji-item {
  font-size: 56rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e5e5ea;
  position: relative;
}

.my-emoji,
.recommended {
  cursor: pointer;
}

.remove-tag {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  font-size: 20rpx;
  background: var(--danger);
  color: #fff;
  border-radius: 20rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.emoji-input {
  font-size: 64rpx;
  text-align: center;
  height: 120rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 36rpx;
  padding: 24rpx 0 40rpx;
}

.big-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 80rpx;
  background: linear-gradient(145deg, #FEF3EC, #FDE8DD);
  display: block;
  object-fit: cover;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.profile-sub {
  color: var(--text2);
  font-size: 28rpx;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1px solid #f0f0f3;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-left {
  font-size: 30rpx;
}

.menu-arrow {
  color: var(--text2);
}

.footer-text {
  display: block;
  text-align: center;
  color: #c6c6c8;
  font-size: 24rpx;
  padding: 32rpx 0;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}
.modal-mask.show { display: flex; }

.modal-box {
  background: #fff;
  border-radius: 56rpx;
  padding: 56rpx 48rpx 48rpx;
  width: 90%;
  max-width: 680rpx;
  max-height: 85vh;
  overflow-y: auto;
}

.rank-modal-box {
  height: 78vh;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.rank-list-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.rank-modal-actions {
  flex-shrink: 0;
  padding-top: 16rpx;
  margin-top: 0;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.btn-cancel {
  flex: 1;
  padding: 24rpx;
  border-radius: 80rpx;
  border: none;
  font-weight: 600;
  font-size: 30rpx;
  background: #f0f0f3;
  color: #3a3a3c;
}

/* 排名 */
.rank-item {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1px solid #f5f5f8;
  gap: 28rpx;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  font-weight: 700;
  color: var(--text2);
  font-size: 28rpx;
  min-width: 60rpx;
}

.rank-emoji {
  font-size: 40rpx;
}

.rank-name {
  flex: 1;
  font-weight: 500;
  font-size: 30rpx;
  color: var(--text);
}

.rank-count {
  font-size: 26rpx;
  color: var(--text2);
}

/* 记录 */
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1px solid #f5f5f8;
}

.record-item:last-child {
  border-bottom: none;
}

.record-date {
  font-weight: 500;
  font-size: 30rpx;
  color: var(--text);
}

.record-count {
  font-size: 26rpx;
  color: var(--text2);
}
