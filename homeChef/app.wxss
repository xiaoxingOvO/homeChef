/* app.wxss - 温暖食光风格 */
page {
  --pri: #FF6B3D;
  --pri-light: #FFF3EE;
  --bg: #FEF9F4;
  --surface: #FFFFFF;
  --text: #2C1810;
  --text2: #A89890;
  --border: #F0E8E0;
  --shadow: 0 4rpx 20rpx rgba(60, 30, 10, 0.06);
  --radius: 44rpx;
  --radius-sm: 28rpx;
  --success: #2ECC71;
  --danger: #E74C3C;
  --star: #FFB84D;

  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  border: 1px solid var(--border);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title .more {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--pri);
  background: var(--pri-light);
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
}

/* 按钮 */
.btn-primary {
  background: var(--pri);
  color: #fff;
  border: none;
  border-radius: 100rpx;
  padding: 30rpx 40rpx;
  font-weight: 700;
  font-size: 32rpx;
  width: 100%;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 61, 0.3);
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-small {
  padding: 20rpx 36rpx;
  font-size: 28rpx;
  width: auto;
  border-radius: 100rpx;
}

.btn-secondary {
  background: #F5F2EF;
  color: var(--pri);
  box-shadow: none;
  font-weight: 600;
}

.btn-success {
  background: var(--success);
  box-shadow: 0 12rpx 40rpx rgba(46, 204, 113, 0.3);
}

.btn-danger {
  background: var(--danger);
  box-shadow: 0 12rpx 40rpx rgba(231, 76, 60, 0.3);
}

.btn-outline {
  background: transparent;
  color: var(--pri);
  border: 1.5px solid #FFD5C5;
}

.btn-sm {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  width: auto;
  border-radius: 100rpx;
  background: var(--pri);
  color: #fff;
  font-weight: 600;
}

.btn-sm:active {
  opacity: 0.7;
}

/* 徽章 */
.badge {
  background: var(--pri-light);
  color: var(--pri);
  padding: 6rpx 28rpx;
  border-radius: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.badge.green {
  background: #E8F8EF;
  color: #27AE60;
}

.badge.orange {
  background: #FFF4E8;
  color: #E67E22;
}

.badge.gray {
  background: #F5F2EF;
  color: var(--text2);
}

/* 搜索栏 */
.search-bar {
  background: #F5F2EF;
  border-radius: 100rpx;
  padding: 24rpx 36rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1.5px solid transparent;
  transition: 0.2s;
}

.search-bar:focus-within {
  border-color: var(--pri);
  background: var(--surface);
  box-shadow: 0 0 0 8rpx rgba(255, 107, 61, 0.06);
}

.search-bar input {
  background: transparent;
  border: none;
  outline: none;
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}

.search-bar input::placeholder {
  color: #C5BDB6;
}

.search-bar .search-icon {
  font-size: 28rpx;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 12rpx 0 28rpx;
  white-space: nowrap;
}

.category-tabs::-webkit-scrollbar {
  display: none;
}

.category-tab {
  background: #F5F2EF;
  padding: 16rpx 40rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text2);
  white-space: nowrap;
  flex-shrink: 0;
  display: inline-block;
}

.category-tab.active {
  background: var(--pri);
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 61, 0.3);
}

/* 星星评分 */
.stars {
  color: var(--star);
  letter-spacing: 2rpx;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text2);
}

.empty-state .big-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

/* Toast */
.toast {
  position: fixed;
  top: 140rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(44, 24, 16, 0.88);
  color: #fff;
  padding: 24rpx 52rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  z-index: 999;
  opacity: 0;
  transition: opacity 0.25s;
  pointer-events: none;
}

.toast.show {
  opacity: 1;
}

/* 菜品网格 */
.dish-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.dish-grid .dish-card {
  width: calc(50% - 12rpx);
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
